# Copy this file to .env and fill in the provider(s) you want to use.
# Scoutly runs with zero keys via the built-in MockClient + MockFetcher
# (SCOUTLY_PROVIDER=mock, SCOUTLY_FETCH_MODE=mock — both the default).

# Which LLM provider main.py / streamlit_app.py should use: anthropic | openai | groq | mock
SCOUTLY_PROVIDER=mock

# Which page-fetching backend the Company/Competitor research agents use: http | mock
# http performs real GET requests against the company/competitor URLs entered.
SCOUTLY_FETCH_MODE=mock

# Claude (default real provider)
ANTHROPIC_API_KEY=

# OpenAI (optional alternative provider)
OPENAI_API_KEY=

# Groq (optional free-tier alternative, via langchain-groq)
GROQ_API_KEY=

# Contact email sent in the User-Agent header for SEC EDGAR 10-K lookups,
# per SEC's fair-access policy. Not a secret — just identifies the requester.
SEC_EDGAR_CONTACT_EMAIL=capstone-project@example.com
